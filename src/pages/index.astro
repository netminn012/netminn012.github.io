---
import Footer from '../components/Footer.astro'; import Icon from '../components/Icon.astro'; import LinkButton from '../components/LinkButton.astro'; import LiquidGlass from '../components/LiquidGlass.astro'; import SiteCard from '../components/SiteCard.astro';
import {mainLinks,operatedSites,otherLinks} from '../data/links'; import '../styles/global.css';
const title='netminn012',description='netminn012のホームページ・リンク集',canonical=new URL('/',Astro.site),ogImage=new URL('/og-image.png',Astro.site);
---
<!doctype html><html lang="ja"><head>
 <meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="description" content={description}/><meta name="theme-color" content="#0b0c12" media="(prefers-color-scheme: dark)"/><meta name="theme-color" content="#edf0f7" media="(prefers-color-scheme: light)"/>
 <link rel="canonical" href={canonical}/><link rel="icon" href="/favicon.svg" type="image/svg+xml"/><link rel="apple-touch-icon" href="/apple-touch-icon.png"/>
 <meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:type" content="website"/><meta property="og:url" content={canonical}/><meta property="og:image" content={ogImage}/><meta property="og:image:width" content="1200"/><meta property="og:image:height" content="630"/><meta property="og:locale" content="ja_JP"/>
 <meta name="twitter:card" content="summary_large_image"/><meta name="twitter:title" content={title}/><meta name="twitter:description" content={description}/><meta name="twitter:image" content={ogImage}/><title>{title}</title>
 <script is:inline>(()=>{try{const s=localStorage.getItem('netminn012-theme');const t=s==='light'||s==='dark'?s:matchMedia('(prefers-color-scheme:light)').matches?'light':'dark';document.documentElement.dataset.theme=t;document.documentElement.style.colorScheme=t}catch{document.documentElement.dataset.theme=matchMedia('(prefers-color-scheme:light)').matches?'light':'dark'}})()</script>
</head><body><a class="skip-link" href="#main-content">本文へ移動</a><div class="ambient ambient--one" aria-hidden="true"></div><div class="ambient ambient--two" aria-hidden="true"></div><div class="page-shell">
 <header class="topbar"><a class="wordmark" href="#top">n/012</a><button class="theme-toggle" id="theme-toggle" type="button" aria-label="ライトテーマに切り替える"><svg class="sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="3.5"/><path d="M12 2v2M12 20v2M4.9 4.9l1.5 1.5M17.6 17.6l1.5 1.5M2 12h2M20 12h2M4.9 19.1l1.5-1.5M17.6 6.4l1.5-1.5"/></svg><svg class="moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.4 15.1A8.5 8.5 0 0 1 8.9 3.6a8.5 8.5 0 1 0 11.5 11.5Z"/></svg><span>テーマ</span></button></header>
 <main id="main-content"><section class="hero" id="top" aria-labelledby="hero-title"><div class="hero__status"><LiquidGlass class="status-glass" strength={12}><span class="status-dot" aria-hidden="true"></span>LINK INDEX / ONLINE</LiquidGlass><span>TOKYO · JP</span></div><div><p class="hero__kicker">all paths lead here</p><h1 id="hero-title">netminn<span>012</span></h1></div><div class="hero__footer"><p>ツイ廃学生<br/>自称ガジェット界隈</p><span aria-hidden="true">SCROLL ↓</span></div></section>
 <section class="section" aria-labelledby="main-title"><header class="section-heading"><p>01 / MAIN</p><h2 id="main-title">Main Links</h2><span>よくいる場所</span></header><div class="main-links-grid">{mainLinks.map((item,index)=><LinkButton item={item} index={index}/>)}</div></section>
 <section class="section" aria-labelledby="other-title"><header class="section-heading"><p>02 / ELSEWHERE</p><h2 id="other-title">Other Links</h2><span>そのほかのアカウント</span></header><div class="other-links-list">{otherLinks.map(item=><a class="other-link" href={item.url} target="_blank" rel="noopener noreferrer"><span class="other-link__icon"><Icon name={item.icon} size={20}/></span><strong>{item.name}</strong><span>{item.description}</span><span class="external-arrow" aria-hidden="true">↗</span></a>)}</div></section>
 <section class="section" aria-labelledby="sites-title"><header class="section-heading"><p>03 / OPERATED</p><h2 id="sites-title">運営しているサイト</h2><span>個人で運営中</span></header><div class="sites-list">{operatedSites.map(item=><SiteCard item={item}/>)}</div></section></main><Footer/>
</div><script>import '../lib/liquid-glass';const key='netminn012-theme',toggle=document.querySelector<HTMLButtonElement>('#theme-toggle'),query=matchMedia('(prefers-color-scheme: light)');const apply=(theme:'light'|'dark')=>{document.documentElement.dataset.theme=theme;document.documentElement.style.colorScheme=theme;if(toggle){const next=theme==='dark'?'ライト':'ダーク';toggle.setAttribute('aria-label',`${next}テーマに切り替える`);toggle.setAttribute('aria-pressed',String(theme==='light'))}};toggle?.addEventListener('click',()=>{const next=document.documentElement.dataset.theme==='dark'?'light':'dark';apply(next);try{localStorage.setItem(key,next)}catch{}});query.addEventListener('change',e=>{try{if(localStorage.getItem(key))return}catch{}apply(e.matches?'light':'dark')});apply(document.documentElement.dataset.theme==='light'?'light':'dark');</script></body></html>
