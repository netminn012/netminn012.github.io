---
import type { LinkItem } from '../data/links';
import Icon from './Icon.astro';

interface Props { item: LinkItem }
const { item } = Astro.props;
---

<a class:list={['main-link', { 'main-link--featured': item.featured }]} href={item.url} target="_blank" rel="noopener noreferrer">
  <span class="link-icon"><Icon name={item.icon} size={24} /></span>
  <span class="link-copy"><strong>{item.name}</strong><span>{item.description}</span></span>
  <span class="external-arrow" aria-hidden="true">↗</span>
</a>
