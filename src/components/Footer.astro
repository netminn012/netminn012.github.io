---
import { siteContent } from '../data/site';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-mark" aria-hidden="true">n/012</div>
  <div><strong>{siteContent.domain}</strong><p>© {year} {siteContent.name}</p></div>
  <nav aria-label="フッターリンク">
    {siteContent.footerLinks.map(link => <a href={link.url} target="_blank" rel="noopener noreferrer">{link.label}</a>)}
  </nav>
</footer>
